# Vorlage – kopieren nach .env und ausfüllen:  cp .env.example .env && chmod 600 .env
# Nach Änderungen Container neu erstellen:     docker compose up -d --force-recreate

# --- Sprachmodell (OpenRouter) ---
# API-Key von https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modell-ID von https://openrouter.ai/models (kostenlose enden auf ":free")
MODEL=qwen/qwen3.8-27b:free
# Ausweichmodelle (kommagetrennt), falls MODEL überlastet ist (Fehler 429)
FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free

# --- Anmeldung ---
# Neue Familienmitglieder werden normalerweise per E-Mail eingeladen (Familie → Jemanden einladen).
# Optionaler Ausweg: Familien-Code für die Selbst-Registrierung (Groß/klein egal). Leer = nur per Einladung.
FAMILY_CODE=

# --- Mailversand (Anmeldecodes, Benachrichtigungen) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absender, falls abweichend vom SMTP_USER
MAIL_FROM=
# Bekommt eine Mail, wenn sich jemand neu registriert (leer = keine Benachrichtigung)
ADMIN_EMAIL=
# Adresse der Seite (für Links in Mails)
APP_URL=https://geschenke.example.de
